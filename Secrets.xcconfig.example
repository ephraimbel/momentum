// Copy this file to `Secrets.xcconfig` (untracked) and fill in your tokens.
// Mapbox runtime token — a public pk.* token; URL-restrict it to the app's bundle id.
MBX_ACCESS_TOKEN = pk.your_mapbox_public_token_here

// Supabase project (docs/SOCIAL-BACKEND-SETUP.md). Leave empty to ship dark (local-only social,
// deterministic AI templates). NOTE: xcconfig treats `//` as a comment — the `$()` in the URL
// below is required to survive parsing. Example: https:/$()/abcdefgh.supabase.co
SUPABASE_URL =
SUPABASE_ANON_KEY =

// TikTok ads attribution (TikTok Events Manager → your iOS app). Leave empty to ship dark —
// the SDK is never initialized without both values.
TIKTOK_APP_ID =
TIKTOK_ACCESS_TOKEN =

// Meta ads attribution (developers.facebook.com app → App ID + Client token). Leave empty to
// ship dark — the SDK is never initialized without both values.
META_APP_ID =
META_CLIENT_TOKEN =

// Sentry Developer ($0) project DSN. This is a public ingestion identifier, not an auth token,
// but it remains environment-specific and untracked. xcconfig treats // as a comment, so preserve
// `$()` after https:. Example: https:/$()/public-key@o123.ingest.us.sentry.io/456
SENTRY_DSN =
// Build-time dSYM upload credential (org:ci only). Never add this to Info.plist.
SENTRY_AUTH_TOKEN =
